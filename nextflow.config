// This includes all of the parameters used in this pipeline.
// Default parameters in place, but they can be changed in your command
// with two dashes, like this "--reads". Or, the params.config file can be
// modified to fit your needs.

includeConfig "${projectDir}/params.config"

manifest {
    /* Homepage of project */
    homePage = 'https://github.com/passdan/FloRes'

    /* Description of project */
    description = 'AMR++: A bioinformatic pipeline for characterizing the resistome with the MEGARes database and the microbiome using Kraken.'

    /* Minimum Nextflow version. The code targets the strict syntax parser. */
    nextflowVersion = '>=25.04.0'

    /* Main pipeline script */
    mainScript = 'main.nf'

    /* Default repository branch */
    defaultBranch = 'master'
}

/*
 * defines execution profiles for different environments
 */

// Below are other config options
profiles {
    local {
        includeConfig "config/local.config"
    }
    local_slurm {
        includeConfig "config/local_slurm.config"
    }
    conda {
        includeConfig "config/conda.config"
        conda.enabled = true
        conda.cacheDir = "${projectDir}/envs/"
        conda.useMamba = true
        conda.createTimeout = '30 min'
    }
    docker {
        includeConfig "config/local.config"
        docker.enabled = true
        process.container = ''
    }
    singularity {
        includeConfig "config/singularity.config"
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/envs/"
    }
    conda_slurm {
        includeConfig "config/conda_slurm.config"
        conda.cacheDir = "${projectDir}/envs/"
        conda.enabled = true
        conda.useMamba = true
        conda.createTimeout = '30 min'
    }
    singularity_slurm {
        includeConfig "config/singularity_slurm.config"
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/envs/"
    }
    apptainer_slurm {
        includeConfig "config/apptainer_slurm.config"
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "${projectDir}/envs/"
    }
    'google-batch' {
        includeConfig "config/google_batch.config"

        // Nextflow parses every profile block, not just the selected one, so bare
        // ${GOOGLE_CLOUD_PROJECT} style interpolation failed outside GCP: implicit
        // environment variables are not supported by the strict syntax parser.
        // Each value is read with System.getenv and a fallback, and assigned to a
        // param first because only params may be referenced as config variables.
        // The fallbacks are deliberately invalid so that selecting this profile
        // without the environment set fails visibly rather than silently.
        params.gcp_project = System.getenv('GOOGLE_CLOUD_PROJECT') ?: 'GOOGLE_CLOUD_PROJECT-is-unset'
        params.gcp_artifact_repo = System.getenv('GOOGLE_ARTIFACT_REPO') ?: 'GOOGLE_ARTIFACT_REPO-is-unset'
        params.gcp_bucket = System.getenv('GCS_BUCKET') ?: 'GCS_BUCKET-is-unset'
        params.gcp_ref_bucket = System.getenv('GCS_REF_BUCKET') ?: params.gcp_bucket
        params.gcp_location = System.getenv('GCS_BUCKET_LOCATION') ?: 'us-central1'
        params.gcp_service_account = System.getenv('GOOGLE_SERVICE_ACCOUNT_EMAIL') ?: ''

        process.executor = 'google-batch'
        process.container = "us-central1-docker.pkg.dev/${params.gcp_project}/${params.gcp_artifact_repo}/flores-workbench:latest"
        process.errorStrategy = { task.exitStatus == 50001 ? 'retry' : 'terminate' }
        process.maxRetries = 2

        workDir = "gs://${params.gcp_bucket}/scratch"
        params.refDir = "gs://${params.gcp_ref_bucket}"

        google.region = params.gcp_location
        google.project = params.gcp_project
        google.batch.serviceAccountEmail = params.gcp_service_account
        google.batch.bootDiskSize = '200 GB'
        google.batch.usePrivateAddress = true
        google.batch.network = "projects/${params.gcp_project}/global/networks/default"
        google.batch.subnetwork = "projects/${params.gcp_project}/regions/${params.gcp_location}/subnetworks/default"
        google.httpConnectTimeout = '10m'
        google.httpReadTimeout = '10m'
        google.batch.maxSpotAttempts = 5

        executor.pollInterval = '30s'
        executor.queueStatInterval = '2m'
    }
    workbench {
        includeConfig "config/google_batch.config"
        process.executor = 'google-batch'
        process.container = "us-central1-docker.pkg.dev/vwb-dev-beaming-hazelnut-6046/nf-containers/flores-workbench:latest"
        process.errorStrategy = { task.exitStatus == 50001 ? 'retry' : 'terminate' }
        process.maxRetries = 5

        workDir = "gs://nf-vwb-dev-beaming-hazelnut-6046/scratch"
        params.refDir = "gs://nf-vwb-dev-beaming-hazelnut-6046"

        google.region = "us-central1"
        google.project = "vwb-dev-beaming-hazelnut-6046"
        google.batch.serviceAccountEmail = "pet-2763419209313c0415b41@vwb-dev-beaming-hazelnut-6046.iam.gserviceaccount.com"
        google.batch.bootDiskSize = '200 GB'
        google.batch.usePrivateAddress = true
        google.batch.network = "projects/vwb-dev-beaming-hazelnut-6046/global/networks/network"
        google.batch.subnetwork = "projects/vwb-dev-beaming-hazelnut-6046/regions/us-central1/subnetworks/subnetwork"
        google.httpConnectTimeout = '10m'
        google.httpReadTimeout = '10m'
        google.batch.maxSpotAttempts = 5

        executor.pollInterval = '30s'
        executor.queueStatInterval = '2m'
    }
}
