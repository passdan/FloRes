/*
 * Google Batch parameter configuration.
 * All file paths use gs:// for cloud execution via Google Batch.
 * Reads the GCS_BUCKET and GCS_REF_BUCKET environment variables.
 *
 * The strict config syntax allows only config assignments, blocks and includes at
 * the top level, and only params may be referenced as variables, so the bucket
 * names are themselves params rather than top-level `def` declarations.
 */

params {
    gcs_bucket = System.getenv("GCS_BUCKET") ?: "nf-files"
    gcs_ref_bucket = System.getenv("GCS_REF_BUCKET") ?: params.gcs_bucket

    help = false
    pipeline = "standard"

    // -----------------------------------------------------------------
    //  Input / Output
    // -----------------------------------------------------------------
    reads = "gs://${params.gcs_bucket}/data/raw/*_R{1,2}.fastq.gz"
    bam_files = null
    split = ""
    output = "gs://${params.gcs_bucket}/results"

    // -----------------------------------------------------------------
    //  Reference Databases
    // -----------------------------------------------------------------
    host = "gs://${params.gcs_ref_bucket}/grch38_1kgmaj.fa"
    host_index = "gs://${params.gcs_ref_bucket}/grch38_1kgmaj{.fa,*.bt2}"
    kraken_db = "gs://${params.gcs_ref_bucket}/minikraken_8GB_20200312"
    amr_index = null
    amr = "gs://${params.gcs_bucket}/data/amr/megares_database_v3.fasta"
    annotation = "gs://${params.gcs_bucket}/data/amr/megares_annotations_v3.00.csv"
    megares_lengths = "gs://${params.gcs_bucket}/data/amr/megares_lengths.txt"
    multiqc = "gs://${params.gcs_bucket}/data/multiqc"

    // -----------------------------------------------------------------
    //  Stage toggles
    // -----------------------------------------------------------------
    fastqc = true
    trim = true
    host_removal = true
    snp = true
    deduped = false
    kraken = true
    bracken = true
    normalise_to_length = true

    // -----------------------------------------------------------------
    //  Analysis parameters
    // -----------------------------------------------------------------
    prefix = "AMR"
    depth_basis = "classified"
    threshold = 80
    min = 5
    max = 100
    skip = 5
    samples = 1
    kraken_confidence_filter = true
    kraken_confidence = 1
    readlen = 150
    taxlevel = "R1,R2,R3,K,P,C,O,F,G,S"
}

env {
    FASTP = "fastp"
    PYTHON3 = "python3"
    BWA = "bwa"
    BOWTIE2 = "bowtie2"
    SAMTOOLS = "samtools"
    KRAKEN2 = "kraken2"
}
