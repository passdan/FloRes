/*
 * Default parameters for the FloRes / AMR++ pipeline.
 *
 * Override any of these on the command line with two dashes, e.g.
 *   nextflow run . --reads "/path/to/*_R{1,2}.fastq.gz" --host_removal false
 *
 * Boolean parameters are read through as_bool() in the pipeline code, so
 * "--kraken false" works even though the strict syntax parser (default from
 * Nextflow 26.04) no longer converts command line values to booleans.
 */

params {
    /* Display the help message */
    help = false

    // -----------------------------------------------------------------
    //  Input / Output
    // -----------------------------------------------------------------

    /* Which pipeline to run: standard, bam, hifi, qc, align, kraken */
    pipeline = "standard"

    /* Location of forward and reverse read pairs */
    reads = "${projectDir}/data/raw/*_R{1,2}.fastq.gz"

    /* Output directory */
    output = "test_results"

    /* BAM input, for --pipeline bam and --pipeline hifi */
    bam_files = null

    /* Split HiFi BAMs into paired FASTQ rather than interleaved */
    split = ""

    // -----------------------------------------------------------------
    //  Reference Databases
    // -----------------------------------------------------------------

    /* Location of host/contaminant genome */
    host = "${projectDir}/data/host/chr21.fasta.gz"

    /* Pre-built bowtie2 host index files, with a wildcard. null builds the index. */
    host_index = null

    /* Kraken2 database. null downloads minikraken. */
    kraken_db = "${projectDir}/data/kraken_pfp"

    /* Pre-built bwa AMR index files, with a wildcard. null builds the index. */
    amr_index = null

    /* Antimicrobial resistance database (MEGARes) */
    amr = "${projectDir}/data/amr/megares_database_v3.00.fasta"

    /* MEGARes annotation file */
    annotation = "${projectDir}/data/amr/megares_annotations_v3.00.csv"

    /* MEGARes gene lengths table (gene_accession<TAB>bp), used by --normalise_to_length */
    megares_lengths = "${projectDir}/data/amr/megares_lengths.txt"

    /* MultiQC configuration directory */
    multiqc = "${projectDir}/data/multiqc"

    // -----------------------------------------------------------------
    //  Stage toggles
    // -----------------------------------------------------------------

    /* FastQC + MultiQC read reporting */
    fastqc = true

    /* fastp trimming and adapter removal */
    trim = true

    /* Host read removal with bowtie2 */
    host_removal = true

    /* SNP confirmation of resistome counts */
    snp = true

    /* Also produce deduplicated counts. Significantly increases run time. */
    deduped = false

    /* Kraken2 taxonomic classification */
    kraken = true

    /* Bracken abundance re-estimation. Requires --kraken true. */
    bracken = true

    /* Normalise count matrices to gene length and sequencing depth (RPKM).
       Requires --kraken true for the sequencing depth. */
    normalise_to_length = true

    // -----------------------------------------------------------------
    //  Analysis parameters
    // -----------------------------------------------------------------

    /* Prefix for resistome output file names */
    prefix = "AMR"

    /* Denominator for length normalisation: classified | total
         classified  column sums of the Kraken matrix, i.e. classified reads
         total       classified plus unclassified, from kraken_unclassifieds.csv
       Values are not comparable between the two bases. */
    depth_basis = "classified"

    /* Resistome gene fraction threshold */
    threshold = 80

    /* Rarefaction: start level, end level, levels to skip, sampling iterations */
    min = 5
    max = 100
    skip = 5
    samples = 1

    /* Also run Kraken2 with a confidence threshold, producing filtered reports */
    kraken_confidence_filter = true
    kraken_confidence = 1

    /* Bracken read length */
    readlen = 150

    /* Bracken taxonomic levels: comma separated from R1,R2,R3,K,P,C,O,F,G,S */
    taxlevel = "R1,R2,R3,K,P,C,O,F,G,S"
}

process {
    cache = 'lenient'
    clusterOptions = '--account=scwf00056_r_silvester_54 --qos=maxjobs100'

    // All error-handling policy lives here rather than in the process definitions.
    // Config takes precedence over a process's own directives, so declaring it in
    // both places would mean the config silently won.
    //   137..140 are out-of-memory and related kills, which are worth retrying.
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries = 3

    // SNP confirmation is best-effort: a failure here should not lose the run's
    // resistome counts, so these are ignored rather than retried. Note that this
    // means --snp true can complete with no SNP matrix; check the Results folder.
    withName: 'runsnp|snpresults' {
        errorStrategy = 'ignore'
    }

    // Bracken exits 1 for a taxonomic level with no reads to redistribute, which
    // is expected for several of the default --taxlevel values. Anything else is
    // a real failure.
    withName: runbracken {
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
    }

    withName: runqc {
        cpus = 16
        memory = "24.GB"
    }

    withName: bowtie2_rm_contaminant_fq {
        cpus = 16
        memory = { 128.GB * task.attempt }
    }

    withName: bwa_align {
        cpus = 16
        memory = { 128.GB * task.attempt }
    }

    withName: runkraken {
        cpus = 16
        memory = "245.GB"
    }

    withName: SAMTOOLS_BAM2FQ {
        cpus = 16
        memory = "32.GB"
    }
}

executor {
    queueSize = 100
}

// Process labels used in the modules, for use with withLabel: in a profile config.
// Containers are assigned per label in the singularity and apptainer profiles.
//   trimming           fastp
//   alignment          bwa, samtools
//   alignmentBowtie2   bowtie2
//   microbiome         kraken2, bracken
//   fastqc             fastqc, multiqc
//   python             scripts in bin/, which run on the base container
// Labels with no withLabel: entry fall back to the process defaults above.

// Point these at a specific binary if the tool is not already on $PATH.
// Each is read in the process scripts as ${TOOL:-default}, so leaving a value
// unset falls back to the plain command name.
env {
    FASTP = "fastp"
    PYTHON3 = "python3"
    BWA = "bwa"
    BOWTIE2 = "bowtie2"
    SAMTOOLS = "samtools"
    KRAKEN2 = "kraken2"
}
